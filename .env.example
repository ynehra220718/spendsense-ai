# AI model via OpenRouter (required)
OPENROUTER_API_KEY=sk-or-your-key-here
DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Price history — Amazon only, free (optional)
# Request a free key at: https://camelcamelcamel.com/api
# If not set, system auto-falls back to mock data for all platforms
CAMELCAMELCAMEL_API_KEY=

# Platform routing is automatic — no config needed:
#   amazon.com / amazon.in / etc. → CamelCamelCamel (if key set) else mock
#   flipkart.com                  → mock (no free API exists)
#   myntra / meesho / snapdeal    → mock
#   unknown URLs / manual entry   → mock
